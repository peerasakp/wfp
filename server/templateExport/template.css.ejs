.justify-center {
    justify-content: center !important;
}
.row {
    display: flex !important;
    flex-wrap: wrap !important;
    margin-left: -8px !important;
    margin-right: -8px !important;
}
.col {
    flex: 1 1 0%;
    max-width: 100%;
}
.col-5 {
    flex: 0 0 40%;
    max-width: 40%;
}

.col-4 {
    flex: 0 0 34.5%;
    max-width: 34.5%;
}


.col-12 {
    flex: 0 0 100%;
    max-width: 100%;
}
.wrap{
    flex-wrap: wrap;
}
.col-sign {
    flex: 0 0 100%;
    max-width: 100%;
    display: flex;
    justify-content: center;
}
.col-sign2 {
    flex: 0 0 100%;
    max-width: 100%;
    display: flex;
    justify-content: start;
}
.text-center {
    text-align: center;
}
.text-dot,
.text-dot-no-value {
    font-size: 12px;
}

.text-dot {
    position: relative;
    flex-grow: 1;
    min-width: fit-content;
}
.text-dot::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1px;
    border-bottom: 1.5px dotted black;
    letter-spacing: 2px;
}
.text-dot-no-value {
    position: relative;
    flex-grow: 1;
    min-width: fit-content;
    padding : 0 4px 0 4px;
    margin : 0 4px 0 4px;
}
.text-dot-no-value::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 3px;
    width: 100%;
    height: 1px;
    border-bottom: 1.5px dotted black;
    letter-spacing: 2px;
}
.text-dot-pl {
    position: relative;
    flex-grow: 1;
    min-width: fit-content;
    padding : 0 4px 0 4px;
    margin : 0 4px 0 4px;
}
.text-dot-pl::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1px;
    border-bottom: 1.5px dotted black;
}
.col-position{
    flex: 0 0 30%;
    max-width: 100%;
    display: flex;
    justify-content: space-evenly;
}
.title-container {
    flex: 1;
    text-align: center;
}
.text-white{
    color: rgba(255, 255, 255, 0);
}
table {
    "baijamjuree" !important;
    border-collapse: collapse;
    width: 100%;
}
td, th {
    font-size : 14px;
    border: 1px solid black;
    text-align: left;
    padding: 8px 8px 8px 16px;
}

.bor{
    border : 1px solid red;
}
.f-start {
    align-items: flex-start;
}

.line-break {
    display: inline-block;
    white-space: nowrap;
    overflow-wrap: break-word;
    word-wrap: break-word;
}

.dynamic-line-break {
    display: block;
    margin-top: 8px;
}

.position-field {
    width: 180px !important;
    max-width: 180px !important;
    min-width: 0 !important;
    flex-grow: 0 !important;
    font-size: 12px !important;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: clip;
}